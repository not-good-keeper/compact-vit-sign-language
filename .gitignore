# ── Datasets (never redistribute; see README for download instructions) ────────
INCLUDE_raw/
INCLUDE_480p/
CISLR/
ISL_CSLTR/
iSign_meta/

# ── Preprocessed crop caches (~80 GB, regenerable via islvit.data.crops) ──────
cache128/
cache128_f32/
cache_cislr/
cache_cislr_f32/
cache_custom/
cache_isign/
cache/

# ── Virtualenv ────────────────────────────────────────────────────────────────
nndlvit/
__pycache__/
*.pyc

# ── Training artefacts: keep summary.json + history.csv, drop checkpoints ─────
*.pt
*.pth
*.ckpt

# ── Third-party model binaries (MediaPipe .task, downloaded separately) ───────
/models/

# ── Local scratch / agent state ───────────────────────────────────────────────
scratch/
.agents/
.include_state/
.f16_seen
.f16_announced

# ── Dataset frame dumps (contain identifiable signers) ────────────────────────
cislr_sample.png
cislr_crops.png

# ── Duplicate log copies ──────────────────────────────────────────────────────
logs_*.txt

# Assistant/editor state
.cursor/
*.code-workspace

# Landmark cache (regenerable via islvit.data.landmarks)
cache_lm_f32/
_lm_smoke/
cache_lm_f32_fresh/
cache128_f32_test/
cache_lm_f32_test/
runs/_val_probs/

# The shipped INT4 models are the one deliberate exception to *.pt
!release/*.pt

# Run logs (results are kept as JSON under runs/)
/*.log

# Demo clips are INCLUDE test videos: rebuild them with `python -m islvit.demo_samples`
demo_samples/

# LaTeX build output (the PDFs that matter are copied to report/final/)
report/final/latex/*.aux
report/final/latex/*.bbl
report/final/latex/*.blg
report/final/latex/*.log
report/final/latex/*.out
report/final/srep/*.aux
report/final/srep/*.bbl
report/final/srep/*.blg
report/final/srep/*.log
report/final/srep/*.out
report/final/srep/*.pdf

# Submission bundles are built from the tracked sources on demand
report/final/*.zip

# Corrections logged by the local UI (per-user data)
runs/corrections.jsonl

# GAN study work directory (patch banks and extraction caches; see runs/gan_study/work_dir_records)
gan_work/
